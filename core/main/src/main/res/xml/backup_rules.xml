<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for devices below API 31, where data_extraction_rules.xml is
   ignored. Same policy: settings ride along automatically, the sandbox and the
   guest home directory do not.

   Note this file is ignored on API 31 and above; see data_extraction_rules.xml.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>