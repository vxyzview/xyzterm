<?xml version="1.0" encoding="utf-8"?>
<!--
   xyzterm stores a Linux home directory inside its sandbox: ~/.ssh keys, shell
   history, dotfiles, and whatever the user has pip/npm/apt installed.

   Those must never leave the device on their own. Cloud backup is enabled by
   Android without any user action, restores onto a different device, and lands
   in someone else's hands if the account is compromised. So the default cloud
   set is settings only.

   Sandbox contents are backed up and restored explicitly, on the user's terms,
   through Settings -> Terminal -> Backups, which produces a .tar.gz the user
   chooses where to put.

   Device transfer is a different contract: it is user-initiated, on the local
   device, and moving a whole Ubuntu home directory to a new phone is exactly
   what people want. So files ride along there.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>